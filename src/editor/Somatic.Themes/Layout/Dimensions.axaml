<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:Double x:Key="MainMenuHeight">24</x:Double>
  <x:Double x:Key="ToolbarHeight">32</x:Double>
  <x:Double x:Key="PanelHeaderHeight">22</x:Double>
  <x:Double x:Key="TabHeight">24</x:Double>

  <x:Double x:Key="HierarchyWidth">260</x:Double>
  <x:Double x:Key="InspectorWidth">290</x:Double>
  <x:Double x:Key="BottomPanelHeight">160</x:Double>

  <x:Double x:Key="SmallSpacing">4</x:Double>
  <x:Double x:Key="MediumSpacing">8</x:Double>
  <x:Double x:Key="LargeSpacing">12</x:Double>

  <x:Double x:Key="IconSize">16</x:Double>
  <x:Double x:Key="SmallIconSize">14</x:Double>

  <Thickness x:Key="EditorBorderThickness">1</Thickness>

</ResourceDictionary>