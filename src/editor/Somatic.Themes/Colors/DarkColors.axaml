<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="EditorBackgroundColor">#FF1E1E1E</Color>
  <Color x:Key="EditorSurfaceColor">#FF2D2D30</Color>
  <Color x:Key="EditorSurfaceElevatedColor">#FF252526</Color>
  <Color x:Key="EditorBorderColor">#FF35353A</Color>
  <Color x:Key="EditorTextPrimaryColor">#FFE4E4E4</Color>
  <Color x:Key="EditorTextSecondaryColor">#FFA0A0A0</Color>
  <Color x:Key="EditorTextDisabledColor">#FF6D6D6D</Color>
  <Color x:Key="EditorAccentColor">#FF3A96DD</Color>
  <Color x:Key="EditorSelectionColor">#FF2C5D87</Color>
  <Color x:Key="EditorHoverColor">#FF3E3E42</Color>
  <Color x:Key="EditorPressedColor">#FF00518C</Color>
  <Color x:Key="EditorWarningColor">#FFD7A32C</Color>
  <Color x:Key="EditorErrorColor">#FFE05252</Color>
  <Color x:Key="ViewportBackgroundColor">#FF181818</Color>
  <Color x:Key="ViewportBorderColor">#FF2A2A2E</Color>

</ResourceDictionary>
