<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="EditorFontFamily">Segoe UI,San Francisco,Noto Sans,sans-serif</FontFamily>

  <x:Double x:Key="FontSizeSmall">11</x:Double>
  <x:Double x:Key="FontSizeNormal">12</x:Double>
  <x:Double x:Key="FontSizeLarge">13</x:Double>

  <FontWeight x:Key="FontWeightRegular">Normal</FontWeight>
  <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
  <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

</ResourceDictionary>
