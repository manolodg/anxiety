<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Somatic.Views.Panels.HierarchyView">
    <Border Background="{DynamicResource EditorSurfaceElevatedBrush}">
		<StackPanel Margin="6" Spacing="3">
			<StackPanel Orientation="Horizontal" Spacing="6">
				<PathIcon Data="{StaticResource IconCube}" Width="12" Height="12" Foreground="{DynamicResource EditorTextSecondaryBrush}" />
                <TextBlock Text="MainCamera" FontSize="{DynamicResource FontSizeSmall}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconLightbulb}" Width="12" Height="12" Foreground="{DynamicResource EditorTextSecondaryBrush}" />
                <TextBlock Text="Directional Light" FontSize="{DynamicResource FontSizeSmall}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12" Foreground="{DynamicResource EditorTextSecondaryBrush}" />
                <TextBlock Text="Environment" FontSize="{DynamicResource FontSizeSmall}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="18,0,0,0">
                <PathIcon Data="{StaticResource IconCube}" Width="12" Height="12" Foreground="{DynamicResource EditorTextSecondaryBrush}" />
                <TextBlock Text="Terrain" FontSize="{DynamicResource FontSizeSmall}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="18,0,0,0">
                <PathIcon Data="{StaticResource IconCube}" Width="12" Height="12" Foreground="{DynamicResource EditorTextSecondaryBrush}" />
                <TextBlock Text="Props" FontSize="{DynamicResource FontSizeSmall}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconCamera}" Width="12" Height="12" Foreground="{DynamicResource EditorTextSecondaryBrush}" />
                <TextBlock Text="Player" FontSize="{DynamicResource FontSizeSmall}" />
              </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
