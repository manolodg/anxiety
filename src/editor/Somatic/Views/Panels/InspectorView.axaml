<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:Somatic.ViewModels.Panels"
             xmlns:inspector="using:Somatic.Views.Inspector"
             xmlns:conv="using:Somatic.Converters"
             xmlns:loc="using:Somatic.Localization"
             x:Class="Somatic.Views.Panels.InspectorView"
             x:DataType="panels:InspectorToolViewModel">

  <Border Background="{DynamicResource EditorSurfaceElevatedBrush}">
    <Grid>

      <TextBlock Text="{Binding NoSelectionText}"
                 IsVisible="{Binding !HasEntity}"
                 FontSize="{DynamicResource FontSizeSmall}"
                 Foreground="{DynamicResource EditorTextDisabledBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

      <DockPanel IsVisible="{Binding HasEntity}">

        <!-- Cabecera de la entidad: activa + icono + nombre. -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource EditorBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <CheckBox Grid.Column="0"
                      Classes="Compact"
                      IsChecked="{Binding Entity.IsActive}"
                      ToolTip.Tip="{loc:Localize EntityActive}" />
            <PathIcon Grid.Column="1"
                      Data="{Binding Entity.Kind, Converter={x:Static conv:EntityIconConverter.Instance}}"
                      Width="14" Height="14" Margin="4,0,6,0"
                      Foreground="{DynamicResource EditorTextSecondaryBrush}" />
            <TextBox Grid.Column="2"
                     Classes="InspectorField"
                     Text="{Binding Entity.Name}"
                     FontWeight="{DynamicResource FontWeightSemiBold}"
                     ToolTip.Tip="{loc:Localize EntityName}" />
          </Grid>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <!-- Stack de componentes: un editor (derivado de ComponentEditor) por componente. -->
            <ItemsControl ItemsSource="{Binding Entity.Components}">
              <ItemsControl.ItemTemplate>
                <inspector:ComponentEditorLocator />
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button HorizontalAlignment="Center"
                    Margin="0,10"
                    Padding="12,3"
                    FontSize="{DynamicResource FontSizeSmall}"
                    IsEnabled="{Binding CanAddComponent}"
                    Content="{loc:Localize AddComponent}">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft"
                            ItemsSource="{Binding AddComponentOptions}"
                            ItemContainerTheme="{StaticResource MenuOptionItemTheme}" />
              </Button.Flyout>
            </Button>

          </StackPanel>
        </ScrollViewer>

      </DockPanel>
    </Grid>
  </Border>

</UserControl>
