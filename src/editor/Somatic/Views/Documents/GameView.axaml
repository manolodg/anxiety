<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Somatic.Views.Documents.GameView">

  <Border Background="{DynamicResource EditorBackgroundBrush}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
      <PathIcon Data="{StaticResource IconPlay}" Width="32" Height="32" Foreground="{DynamicResource EditorTextDisabledBrush}" HorizontalAlignment="Center" />
      <TextBlock Text="Game view placeholder" Foreground="{DynamicResource EditorTextDisabledBrush}" HorizontalAlignment="Center" />
    </StackPanel>
  </Border>

</UserControl>